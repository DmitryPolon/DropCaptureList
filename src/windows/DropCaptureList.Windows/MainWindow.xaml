<Window x:Class="DropCaptureList.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:DropCaptureList.Windows.Helpers"
        Title="DropCaptureList"
        Height="720"
        Width="960"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:HexToBrushConverter x:Key="HexToBrush"/>
        <helpers:BoolToFontWeightConverter x:Key="BoolToWeight"/>
        <helpers:CompletedOpacityConverter x:Key="CompletedOpacity"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Excel capture"/>
                    <TextBlock Margin="0,4,0,0" Foreground="#475569">
                        <Run Text="{Binding Nickname, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding RoleLabel, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding HouseholdLabel, Mode=OneWay}"/>
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding Households}"
                              SelectedItem="{Binding SelectedHousehold}"
                              DisplayMemberPath="Name"
                              Width="220"
                              HorizontalAlignment="Left"
                              Margin="0,8,0,0"
                              Visibility="{Binding ShowHouseholdSwitcher, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Admin"
                            Height="32"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Command="{Binding OpenAdminCommand}"
                            Visibility="{Binding IsAppAdmin, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Capture selected Excel cells"
                            Height="32"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            Command="{Binding CaptureCommand}"/>
                    <Button Content="Delete selected"
                            Height="32"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            ToolTip="Remove cells that should not have been captured."
                            Click="DeleteSelected_OnClick"/>
                    <Button Content="Clear list"
                            Height="32"
                            Padding="12,0"
                            Margin="0,0,8,0"
                            ToolTip="This list is done. Removes all items from the live list."
                            Click="ClearHousehold_OnClick"/>
                    <Button Content="Sign out"
                            Height="32"
                            Padding="12,0"
                            Command="{Binding SignOutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#334155"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Cell size" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0"/>
                <Slider Width="180"
                        Minimum="64"
                        Maximum="220"
                        TickFrequency="4"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        Value="{Binding CellWidth, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="8" BorderBrush="#CBD5E1" BorderThickness="1" Background="White">
                <ScrollViewer HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Visible"
                              CanContentScroll="False">
                    <ItemsControl ItemsSource="{Binding ReplicaRows}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding DataContext.CellWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Height="{Binding DataContext.CellHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Margin="0,0,1,1" Padding="4,0"
                                                    BorderBrush="#94A3B8" BorderThickness="1"
                                                    Opacity="{Binding IsCompleted, Converter={StaticResource CompletedOpacity}}"
                                                    Background="{Binding FillColor, Converter={StaticResource HexToBrush}}">
                                                <TextBlock Text="{Binding Text}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           Foreground="{Binding FontColor, Converter={StaticResource HexToBrush}, ConverterParameter=text}"
                                                           FontWeight="{Binding IsBold, Converter={StaticResource BoolToWeight}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="#E2E8F0"/>

            <DataGrid x:Name="ItemsGrid"
                      Grid.Row="2"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      SelectionMode="Extended"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Margin="8">
                <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Background" Value="#F1F5F9"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                    <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*"/>
                    <DataGridTextColumn Header="Nickname" Binding="{Binding Nickname}" Width="100"/>
                    <DataGridTextColumn Header="Household" Binding="{Binding TenantName}" Width="120"/>
                    <DataGridTextColumn Header="Captured" Binding="{Binding CreatedAt, StringFormat=g}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
