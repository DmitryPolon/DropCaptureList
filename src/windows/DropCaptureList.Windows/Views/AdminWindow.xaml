<Window x:Class="DropCaptureList.Windows.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Household"
        Height="680"
        Width="720"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#B91C1C" Margin="0,12,0,0" TextWrapping="Wrap"/>

        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding HouseholdName}"/>
            <TextBlock Margin="0,4,0,12" Foreground="#64748B" TextWrapping="Wrap"
                       Text="Members of this household can add people by email and remove them. The shared list lives as JSON on the API."/>
            <TextBlock Margin="0,0,0,16">
                <Run Text="Web app: "/>
                <Hyperlink NavigateUri="https://droplist.azpcloud.com" RequestNavigate="WebAppLink_OnRequestNavigate">
                    <Run Text="{Binding WebAppUrl, Mode=OneWay}"/>
                </Hyperlink>
            </TextBlock>

            <StackPanel>
                <TextBlock Text="Household motto" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                    <TextBox Text="{Binding MottoText, UpdateSourceTrigger=PropertyChanged}" Width="360"/>
                    <Button Content="Save motto" Margin="8,0,0,0" Padding="10,0" Command="{Binding SaveMottoCommand}"/>
                </StackPanel>
                <TextBlock Text="Shown on the phone. Leave blank to clear it." Foreground="#64748B" FontSize="11" Margin="0,0,0,16"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Add a member" FontWeight="SemiBold"/>
                <Grid Margin="0,6,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding NewNickname, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Add" Width="80" Command="{Binding AddMemberCommand}"/>
                </Grid>
                <TextBlock Text="Email · nickname. They sign in with this email and this household name." Foreground="#64748B" FontSize="11" Margin="0,0,0,12"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Members" FontWeight="SemiBold"/>
                <Button Content="Remove selected" Margin="0,6,0,8" HorizontalAlignment="Left" Padding="10,4" Command="{Binding RemoveMemberCommand}"/>
                <DataGrid Height="200"
                          ItemsSource="{Binding Members}"
                          SelectedItem="{Binding SelectedMember}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nickname" Binding="{Binding Nickname}" Width="140"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        <DataGridCheckBoxColumn Header="App admin" Binding="{Binding IsAppAdmin}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel Visibility="{Binding IsAppAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="App admin" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"
                           Text="Create a household and add its first member. You can delete any household."/>
                <TextBlock Text="Create household" FontWeight="SemiBold"/>
                <Grid Margin="0,6,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding NewHouseholdName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewHouseholdMotto, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding FirstMemberEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FirstMemberNickname, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                    <Button Grid.Row="2" Grid.Column="0" Content="Create" Width="90" HorizontalAlignment="Left" Command="{Binding CreateHouseholdCommand}"/>
                </Grid>
                <TextBlock Text="Name · motto · first member email · nickname" Foreground="#64748B" FontSize="11" Margin="0,0,0,12"/>

                <TextBlock Text="Delete household" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                    <TextBox Text="{Binding DeleteHouseholdName, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                    <Button Content="Delete" Margin="8,0,0,0" Width="90" Command="{Binding DeleteHouseholdCommand}"/>
                </StackPanel>
                <TextBlock Text="Type the household name. This removes the folder, list, and memberships." Foreground="#64748B" FontSize="11"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
