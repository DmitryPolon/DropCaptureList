<Window x:Class="DropCaptureList.Windows.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropCaptureList"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="DropCaptureList" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Sign in with the email an app admin registered. Session is remembered on this PC."
                   TextWrapping="Wrap"
                   Foreground="#64748B"
                   Margin="0,6,0,16"/>

        <TextBlock Text="Email"/>
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>

        <TextBlock Text="Household"/>
        <TextBox Text="{Binding HouseholdName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>
        <ItemsControl ItemsSource="{Binding KnownHouseholds}" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#64748B" Margin="0,0,12,0" FontSize="12"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Continue"
                HorizontalAlignment="Right"
                Width="110"
                Height="28"
                IsDefault="True"
                Command="{Binding ContinueCommand}"/>

        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="#B91C1C"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>
    </StackPanel>
</Window>
